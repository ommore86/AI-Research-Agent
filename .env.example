# AI Provider API Keys
# Provide at least one key if using a live provider, or leave empty to use offline mock mode
OPENAI_API_KEY=
GEMINI_API_KEY=

# LLM Provider selection: "mock", "openai", or "gemini"
# "mock" runs deterministically without an API key (ideal for testing, offline demos, CI/CD)
DEFAULT_LLM_PROVIDER=mock

# Model names
OPENAI_MODEL=gpt-4o-mini
GEMINI_MODEL=gemini-2.5-flash

# Operational Limits & Timeouts
MAX_SEARCH_RESULTS=5
MAX_PAGES_TO_SCRAPE=3
TOOL_TIMEOUT_SECONDS=10
CACHE_ENABLED=true
CACHE_TTL_SECONDS=3600

# Logging level: DEBUG, INFO, WARNING, ERROR
LOG_LEVEL=INFO
